# Deny everything by default. Re-include only inputs used by deploy/Dockerfile.
**

!deploy/
!deploy/Dockerfile
!requirements.txt

!src/
!src/**
!packs/
!packs/**

!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/admin.html
!frontend/vite.config.js
!frontend/tailwind.config.js
!frontend/src/
!frontend/src/**

# Re-included source trees may contain local caches or OS metadata.
**/__pycache__/
**/*.py[cod]
**/*:Zone.Identifier
