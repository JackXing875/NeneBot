# ============================================================
# Persona Studio Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# ------------------------------------------------------------
# LLM Provider: ollama | claude | deepseek | openai
# ------------------------------------------------------------
LLM_PROVIDER=ollama

# --- Claude (Anthropic) ---
# Get key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL_NAME=claude-haiku-4-5-20251001   # cheapest, very fast
# CLAUDE_MODEL_NAME=claude-sonnet-4-6           # best quality
# LLM_TEMPERATURE_CLAUDE=1.0
# LLM_MAX_TOKENS_CLAUDE=512

# --- DeepSeek (recommended: cheap + very capable for roleplay) ---
# Get key at: https://platform.deepseek.com/
# OPENAI_COMPAT_API_KEY=sk-...
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
# OPENAI_COMPAT_MODEL=deepseek-chat
# LLM_TEMPERATURE_OPENAI=0.7
# LLM_MAX_TOKENS_OPENAI=512

# --- Ollama (local dev only) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_NAME=qwen2.5
# LLM_TEMPERATURE_OLLAMA=0.7
# LLM_TOP_P_OLLAMA=0.9

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# CORS_ALLOW_ORIGINS=*  # comma-separated or "*" for all

# ------------------------------------------------------------
# RAG
# ------------------------------------------------------------
ACTIVE_PACK_ID=mira-demo
PACK_SOURCE_PATH=./packs/demo
ARTIFACT_STORE_PATH=./artifacts
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
MATCH_THRESHOLD=0.55

# ------------------------------------------------------------
# Session Storage
# ------------------------------------------------------------
# memory | redis
SESSION_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=86400

SESSION_MAX_HISTORY=20

# ------------------------------------------------------------
# Reliability / Limits
# ------------------------------------------------------------
API_RATE_LIMIT_COUNT=20
API_RATE_LIMIT_WINDOW_SECONDS=60
API_AUTH_ENABLED=false
API_AUTH_TOKENS=
API_AUTH_REGISTRY_PATH=./config/api_tokens.json
# Examples:
# API_AUTH_TOKENS=ci-bot|chat:dev-token-1,ops|ops:dev-token-2
# API_AUTH_TOKENS=dev-token-1,dev-token-2
TRACING_ENABLED=false
TRACING_SERVICE_NAME=persona-studio
TRACING_EXPORTER=console
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ------------------------------------------------------------
# Telegram Adapter
# ------------------------------------------------------------
# Create a bot via @BotFather and paste the token below.
# Start with: python scripts/launch.py telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_TOP_K=3
TELEGRAM_WEBHOOK_PATH=/integrations/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_BASE_URL=
